rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // My own staff profile, keyed by my Firebase Auth UID (not email —
    // Firestore rules can't safely transform request.auth.token.email
    // into a sanitized doc ID, so UID is the only reliable key to look
    // ourselves up by).
    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function hasProfile() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isSuperUser() {
      return hasProfile() && myProfile().data.status == 'ACTIVE' && myProfile().data.role == 'SUPER_USER';
    }

    // Any signed-in, approved (ACTIVE) staff account — any role.
    function isActiveStaff() {
      return hasProfile() && myProfile().data.status == 'ACTIVE';
    }

    function isStaff() {
      return isSuperUser() || isActiveStaff();
    }

    match /users/{userId} {
      // Read stays open (not gated behind sign-in): the sign-up screen
      // needs to check whether an email is already registered, and
      // forgot-password needs to check an account exists, both BEFORE
      // the visitor has a Firebase Auth session. Known, deliberate gap:
      // staff emails/names/roles are visible to anyone with the app's
      // config. Tightening further would mean moving those two checks
      // into a Cloud Function instead of a direct client read.
      allow read: if true;

      // A signed-in user may create ONLY their own profile document (its
      // ID must equal their own UID), and it must always start at the
      // lowest privilege level with PENDING status. This covers both a
      // brand-new self-registration AND the one-time migration of a
      // pre-existing account into this UID-keyed scheme — either way, a
      // Super Admin must approve and assign the real role afterward,
      // exactly like a new hire. This can never be used to grant
      // yourself an elevated role or ACTIVE status.
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.status == 'PENDING'
        && request.resource.data.role in ['REGISTRAR', 'LEASING_OFFICER', 'FINANCIAL_OFFICER'];

      // Only an approved Super Admin can approve/reject/edit/delete any
      // staff record, including changing someone's role or status.
      allow update, delete: if isSuperUser();
    }

    // The municipal logo is displayed on the public, pre-auth login
    // screen, so it has to be readable before anyone signs in — unlike
    // everything else in settings/, which is only meaningful once you're
    // already inside the app. Writes still require staff; only the read
    // is opened up, and only for this one document.
    match /settings/global_logo {
      allow read: if true;
      allow write: if isStaff();
    }

    // Everything else (tenant applications, assets, SMS logs, rent
    // settings, templates, etc.) requires a signed-in, ACTIVE staff
    // session — not merely "signed in", which was the previous gap that
    // let a still-PENDING self-registered account read/write live data.
    match /{document=**} {
      allow read, write: if isStaff();
    }
  }
}
