rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Staff directory. Read stays open (no `if false` gate) because the
    // sign-up and forgot-password screens need to check for an existing
    // account by email *before* the visitor is signed in, so Firebase
    // Auth isn't populated yet at that point. Writes require sign-in,
    // which blocks anonymous internet users from creating, editing, or
    // deleting staff accounts (the previous rule allowed this).
    //
    // Known gap: because this collection is publicly readable, staff
    // emails/names/roles are visible to anyone with the project's config.
    // Tightening this further would mean moving the duplicate-email and
    // account-existence checks into a Cloud Function instead of a direct
    // client read — a larger change, out of scope for this pass.
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Everything else (tenant applications, assets, SMS logs, rent
    // settings, templates, etc.) requires a signed-in Firebase Auth
    // session for both read and write. This app has no public-facing
    // flow — all registration and management happens after staff log in.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
