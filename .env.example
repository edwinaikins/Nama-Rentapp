# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# WIGAL_API_KEY: The API key for frog.wigal.com.gh SMS integration
WIGAL_API_KEY=

# WIGAL_USERNAME: The username email associated with your Wigal v3 account
WIGAL_USERNAME=

# WIGAL_CLIENT_ID: Backwards-compatible client ID (fallback for username)
WIGAL_CLIENT_ID=

# WIGAL_SENDER_ID: Alphanumeric Sender ID associated with your Wigal account (e.g., NAMA)
WIGAL_SENDER_ID=

# VITE_FIREBASE_API_KEY: Firebase Web API key for this project.
# Must be prefixed with VITE_ so Vite exposes it to client-side code.
# Rotate this key in the Google Cloud Console / Firebase console if it was
# ever committed to source control, then set the new value here.
VITE_FIREBASE_API_KEY=
